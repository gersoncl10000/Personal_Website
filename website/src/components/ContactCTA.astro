---
import { identity } from "../data/content";
---

<section class="contact-cta">
  <div class="wrap cta-inner">
    <div>
      <p class="eyebrow">EL SIGUIENTE PASO</p>
      <h2>
        Hablemos de lo que
        <br />
        necesita cambiar.
      </h2>
      <p>
        Un proceso que no escala. Un sistema que no conecta.
        <br />
        Una oportunidad de IA que merece evaluarse.
      </p>
    </div>
    <a
      class="button light"
      href={identity.linkedin}
      target="_blank"
      rel="noopener noreferrer"
    >
      Hablemos por LinkedIn <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>
