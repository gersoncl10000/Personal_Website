---
import "../styles/tokens.css";
import "@fontsource-variable/manrope";
import "@fontsource-variable/inter";
import "../styles/global.css";
import { castilloOffice, identity } from "../data/content";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import manropeLatin from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url";
const {
  title = identity.name,
  description = "Modernización y automatización de la función financiera con Gerson Castillo. Diagnóstico, sistemas y proyectos por fases hasta la puesta en marcha.",
  noindex = false,
} = Astro.props;
const current = Astro.url.pathname;
const canonical = new URL(current, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href={interLatin}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={manropeLatin}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <title>{title}</title>
    <link
      rel="icon"
      type="image/png"
      sizes="200x200"
      href="/images/castillo-symbol.png"
    />
    <link rel="apple-touch-icon" href="/images/castillo-symbol.png" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content={new URL("/images/castillo-social.png", Astro.site)}
    />
    <meta
      property="og:image:alt"
      content="Castillo · Transformación Financiera"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={new URL("/images/castillo-social.png", Astro.site)}
    />
    <meta name="theme-color" content="#081327" />
    {noindex && <meta name="robots" content="noindex" />}
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        name: identity.name,
        url: Astro.site,
        logo: new URL("/images/castillo-symbol.png", Astro.site),
        image: new URL("/images/castillo-symbol.png", Astro.site),
        address: {
          "@type": "PostalAddress",
          streetAddress: castilloOffice.streetAddress,
          postalCode: castilloOffice.postalCode,
          addressLocality: castilloOffice.locality,
          addressCountry: "ES",
        },
        founder: {
          "@type": "Person",
          name: "Gerson Castillo",
          url: new URL("/sobre-castillo/", Astro.site),
          sameAs: identity.linkedin,
        },
      })}
    ></script>
  </head>
  <body>
    <a class="skip" href="#contenido">
      Saltar al contenido
    </a>
    <header class="header">
      <div class="wrap header-inner">
        <a class="wordmark" href="/">
          <strong>
            CASTILLO<span>·</span>
          </strong>
          <small>TRANSFORMACIÓN FINANCIERA</small>
        </a>
        <button
          class="menu-toggle"
          aria-expanded="false"
          aria-controls="navigation"
          hidden
        >
          Menú <span aria-hidden="true">☰</span>
        </button>
        <nav id="navigation" aria-label="Navegación principal">
          <a href="/#servicios">Qué hago</a>
          <a href="/#como-trabajo">Cómo trabajo</a>
          <a
            href="/ia-finanzas/"
            aria-current={current === "/ia-finanzas/" ? "page" : undefined}
          >
            Agentes de IA
          </a>
          <a
            href="/sobre-castillo/"
            aria-current={current === "/sobre-castillo/" ? "page" : undefined}
          >
            Sobre Castillo
          </a>
          <a
            class="nav-contact"
            href="/contacto/"
            aria-current={current === "/contacto/" ? "page" : undefined}
          >
            Hablemos <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer>
      <div class="wrap footer-top">
        <a class="wordmark" href="/">
          <strong>
            CASTILLO<span>·</span>
          </strong>
          <small>TRANSFORMACIÓN FINANCIERA</small>
        </a>
        <p>
          Finanzas, procesos, datos y tecnología.
          <br />
          Conectados para avanzar.
        </p>
        <a href={identity.linkedin} target="_blank" rel="noopener noreferrer">
          LinkedIn ↗
        </a>
      </div>
      <div class="wrap footer-bottom">
        <span>© {new Date().getFullYear()} Gerson Castillo</span>
        <span>Práctica profesional independiente</span>
        <a href="/sobre-castillo/">Sobre Castillo</a>
        <a href="/contacto/">Contacto</a>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const nav = document.querySelector<HTMLElement>("#navigation");
      if (toggle && nav) {
        toggle.hidden = false;
        const close = () => {
          toggle.setAttribute("aria-expanded", "false");
          nav.classList.remove("open");
        };
        toggle.addEventListener("click", () => {
          const open = toggle.getAttribute("aria-expanded") !== "true";
          toggle.setAttribute("aria-expanded", String(open));
          nav.classList.toggle("open", open);
        });
        nav
          .querySelectorAll("a")
          .forEach((a) => a.addEventListener("click", close));
        document.addEventListener("keydown", (e) => {
          if (
            e.key === "Escape" &&
            toggle.getAttribute("aria-expanded") === "true"
          ) {
            close();
            toggle.focus();
          }
        });
        document.documentElement.classList.add("js");
      }
    </script>
  </body>
</html>
