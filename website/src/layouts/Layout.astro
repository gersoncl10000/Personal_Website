---
import "../styles/tokens.css";
import "@fontsource-variable/manrope";
import "@fontsource-variable/inter";
import "../styles/global.css";
import { identity } from "../data/content";
const {
  title = identity.name,
  description = "Transformación financiera que conecta procesos, sistemas y Data & AI. Del diagnóstico a la solución implantada, con Gerson Castillo.",
  noindex = false,
} = Astro.props;
const current = Astro.url.pathname;
const canonical = new URL(current, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/images/castillo-symbol.png" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#081327" />
    {noindex && <meta name="robots" content="noindex" />}
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "ProfessionalService",
        name: identity.name,
        url: Astro.site,
        founder: { "@type": "Person", name: "Gerson Castillo" },
      })}
    ></script>
  </head>
  <body>
    <a class="skip" href="#contenido">
      Saltar al contenido
    </a>
    <header class="header">
      <div class="wrap header-inner">
        <a class="wordmark" href="/" aria-label="Castillo, inicio">
          <strong>
            CASTILLO<span>·</span>
          </strong>
          <small>TRANSFORMACIÓN FINANCIERA</small>
        </a>
        <button
          class="menu-toggle"
          aria-expanded="false"
          aria-controls="navigation"
          hidden
        >
          Menú <span aria-hidden="true">☰</span>
        </button>
        <nav id="navigation" aria-label="Navegación principal">
          <a href="/#capacidades">Capacidades</a>
          <a
            href="/ia-finanzas/"
            aria-current={current === "/ia-finanzas/" ? "page" : undefined}
          >
            Data & AI
          </a>
          <a href="/#enfoque">Enfoque</a>
          <a href="/#gerson">Gerson Castillo</a>
          <a class="nav-contact" href="/contacto/">
            Hablemos <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </div>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer>
      <div class="wrap footer-top">
        <a class="wordmark" href="/">
          <strong>
            CASTILLO<span>·</span>
          </strong>
          <small>TRANSFORMACIÓN FINANCIERA</small>
        </a>
        <p>
          Finanzas, procesos, datos y tecnología.
          <br />
          Conectados para avanzar.
        </p>
        <a href={identity.linkedin} target="_blank" rel="noopener noreferrer">
          LinkedIn ↗
        </a>
      </div>
      <div class="wrap footer-bottom">
        <span>© {new Date().getFullYear()} Gerson Castillo</span>
        <span>Práctica profesional independiente</span>
        <a href="/contacto/">Contacto</a>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
      const nav = document.querySelector<HTMLElement>("#navigation");
      if (toggle && nav) {
        toggle.hidden = false;
        const close = () => {
          toggle.setAttribute("aria-expanded", "false");
          nav.classList.remove("open");
        };
        toggle.addEventListener("click", () => {
          const open = toggle.getAttribute("aria-expanded") !== "true";
          toggle.setAttribute("aria-expanded", String(open));
          nav.classList.toggle("open", open);
        });
        nav
          .querySelectorAll("a")
          .forEach((a) => a.addEventListener("click", close));
        document.addEventListener("keydown", (e) => {
          if (
            e.key === "Escape" &&
            toggle.getAttribute("aria-expanded") === "true"
          ) {
            close();
            toggle.focus();
          }
        });
        document.documentElement.classList.add("js");
      }
    </script>
  </body>
</html>
