---
import Layout from "../layouts/Layout.astro";
import AzhumLogo from "../components/AzhumLogo.astro";
import CastilloOffice from "../components/CastilloOffice.astro";
import ContactCTA from "../components/ContactCTA.astro";
import { education, identity } from "../data/content";
---

<Layout
  title="Sobre Castillo · Transformación Financiera"
  description="Proyectos de transformación financiera: procesos, sistemas, datos e implantación. Dirección de Gerson Castillo, con experiencia financiera y en software. Madrid."
>
  <section class="page-hero about-hero">
    <div class="wrap">
      <p class="eyebrow">CASTILLO · TRANSFORMACIÓN FINANCIERA</p>
      <h1>Sobre Castillo</h1>
      <p class="lead">
        Castillo desarrolla proyectos de transformación financiera: procesos,
        sistemas, datos y automatización, desde el diagnóstico hasta la puesta
        en marcha.
      </p>
    </div>
  </section>

  <section class="section about-intro">
    <div class="wrap split">
      <p class="eyebrow">PROYECTOS</p>
      <div>
        <h2>Dirección y coordinación del proyecto</h2>
        <div class="two-copy">
          <p>
            El director financiero y su equipo participan en la definición del
            problema, las prioridades y el resultado que debe conseguirse.
          </p>
          <p>
            Gerson Castillo dirige los proyectos, en colaboración con los
            equipos del cliente, IT y los proveedores o especialistas que el
            alcance requiere.
          </p>
        </div>
        <a class="text-link" href="/#como-trabajo">
          Metodología <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section founder about-founder">
    <div class="wrap founder-grid">
      <div class="founder-photo">
        <img
          src="/images/gerson.jpg"
          alt="Retrato profesional de Gerson Castillo"
          width="1280"
          height="1280"
        />
        <span>17 AÑOS EN FINANZAS</span>
      </div>
      <div class="founder-copy">
        <p class="eyebrow">DIRECCIÓN</p>
        <h2>Gerson Castillo</h2>
        <p class="lead">
          Llevo 17 años en Finanzas, con responsabilidades de dirección en
          organizaciones multisociedad de Latinoamérica y Europa.
        </p>
        <p>
          Mis responsabilidades han incluido contabilidad y estados
          consolidados, tesorería, planificación y relación con bancos.
        </p>
        <a
          class="text-link"
          href={identity.linkedin}
          target="_blank"
          rel="noopener noreferrer"
        >
          Ver trayectoria completa en LinkedIn <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section career-section">
    <div class="wrap split">
      <p class="eyebrow">SISTEMAS</p>
      <div>
        <h2>Implantación de software financiero</h2>
        <div class="two-copy">
          <p>
            He dirigido implantaciones de software de consolidación financiera
            para grupos de Iberia y Latinoamérica.
          </p>
          <p>
            Fui subdirector financiero en un grupo español de transporte y
            logística, donde trabajé con IT en el diseño e implantación de
            sistemas financieros.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section education-section">
    <div class="wrap split">
      <div>
        <p class="eyebrow">FORMACIÓN ACADÉMICA</p>
        <h2>Titulaciones universitarias</h2>
      </div>
      <ul class="education-list">
        {education.map(([degree, institution]) => (
          <li>
            <strong>{degree}</strong>
            <span>{institution}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="azhum-section about-azhum">
    <div class="wrap azhum-grid">
      <div>
        <p class="eyebrow">TECNOLOGÍA PROPIA</p>
        <h2 class="azhum-logo">
          <AzhumLogo />
        </h2>
      </div>
      <div>
        <h3>Plataforma de inteligencia financiera</h3>
        <p>
          He diseñado y construido Azhum, una plataforma de inteligencia
          financiera que combina contabilidad analítica y una capa de agentes de
          IA sobre información financiera trazada.
        </p>
        <p>
          Su uso depende del proyecto. La arquitectura puede apoyarse en el ERP
          existente, integraciones u otras herramientas de mercado.
        </p>
        <a
          class="text-link"
          href={identity.azhum}
          target="_blank"
          rel="noopener noreferrer"
        >
          Ver Azhum <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <CastilloOffice />

  <ContactCTA />
</Layout>
