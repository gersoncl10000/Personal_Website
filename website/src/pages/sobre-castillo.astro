---
import Layout from "../layouts/Layout.astro";
import AzhumLogo from "../components/AzhumLogo.astro";
import CastilloOffice from "../components/CastilloOffice.astro";
import ContactCTA from "../components/ContactCTA.astro";
import { careerPath, education, identity } from "../data/content";
---

<Layout
  title="Gerson Castillo | Finanzas, sistemas y transformación"
  description="17 años en Finanzas, dirección financiera multisociedad, implantación de software de consolidación y construcción de Azhum. Conoce la práctica independiente de Gerson Castillo."
>
  <section class="page-hero about-hero">
    <div class="wrap">
      <p class="eyebrow">SOBRE CASTILLO</p>
      <h1>
        Finanzas, sistemas
        <br />
        <em>y transformación.</em>
      </h1>
      <p class="lead">
        Castillo es mi práctica profesional independiente. Conecto el criterio
        financiero con el diseño y la construcción de soluciones para modernizar
        cómo trabaja Finanzas.
      </p>
    </div>
  </section>

  <section class="section founder about-founder">
    <div class="wrap founder-grid">
      <div class="founder-photo">
        <img
          src="/images/gerson.jpg"
          alt="Retrato profesional de Gerson Castillo"
          width="1280"
          height="1280"
        />
        <span>17 AÑOS EN FINANZAS</span>
      </div>
      <div class="founder-copy">
        <p class="eyebrow">GERSON CASTILLO</p>
        <h2>Entender Finanzas. Saber construir.</h2>
        <p class="lead">
          Soy Gerson Castillo. Mi trayectoria combina 17 años en Finanzas con
          implantación de sistemas y desarrollo de software, en entornos
          multisociedad entre Latinoamérica y Europa.
        </p>
        <p>
          He trabajado desde tres posiciones: como responsable financiero que
          decide y utiliza tecnología, como profesional que dirige
          implantaciones y como fundador que construye producto. Esa experiencia
          me permite entender el problema del director financiero y traducirlo a
          procesos, requisitos y soluciones operativas.
        </p>
        <a
          class="text-link"
          href={identity.linkedin}
          target="_blank"
          rel="noopener noreferrer"
        >
          Ver trayectoria completa en LinkedIn <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section career-section">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">TRAYECTORIA</p>
          <h2>De la función financiera a la construcción de soluciones.</h2>
        </div>
        <p>
          Experiencia dentro de Finanzas, en implantación de sistemas y en
          desarrollo de producto.
        </p>
      </div>
      <ol class="career-timeline">
        {careerPath.map(([title, description], index) => (
          <li>
            <span>0{index + 1}</span>
            <div>
              <h3>{title}</h3>
              <p>{description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section about-intro">
    <div class="wrap split">
      <p class="eyebrow">LA PRÁCTICA ACTUAL</p>
      <div>
        <h2>Diagnosticar, priorizar y llevar cada mejora a operación.</h2>
        <div class="two-copy">
          <p>
            Castillo nace de esa combinación de Finanzas y Tecnología. Reviso
            cómo trabaja el equipo, qué sistemas utiliza y dónde se pierde
            tiempo o fiabilidad. Con el director financiero, delimito el
            problema y priorizo mejoras con alcance y entregables claros.
          </p>
          <p>
            Lidero personalmente cada proyecto. Construyo directamente cuando el
            alcance encaja, o especifico y dirijo el trabajo con IT, proveedores
            y especialistas externos. Acompaño las pruebas, la puesta en marcha
            y el traspaso al equipo del cliente.
          </p>
        </div>
        <a class="text-link" href="/#como-trabajo">
          Cómo trabajo <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section education-section">
    <div class="wrap split">
      <div>
        <p class="eyebrow">FORMACIÓN ACADÉMICA</p>
        <h2>Base financiera, jurídica y tecnológica.</h2>
      </div>
      <ul class="education-list">
        {education.map(([degree, institution]) => (
          <li>
            <strong>{degree}</strong>
            <span>{institution}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="azhum-section about-azhum">
    <div class="wrap azhum-grid">
      <div>
        <p class="eyebrow">TECNOLOGÍA PROPIA / INTELIGENCIA FINANCIERA</p>
        <h2 class="azhum-logo">
          <AzhumLogo />
        </h2>
      </div>
      <div>
        <h3>Azhum, una herramienta que he construido.</h3>
        <p>
          Azhum es la plataforma de inteligencia financiera que he diseñado y
          construido. Combina contabilidad analítica y una capa de agentes de IA
          sobre información financiera trazada.
        </p>
        <p>
          La utilizo cuando encaja como parte de la solución. Cuando el problema
          requiere mejorar el ERP, integrar otros sistemas o trabajar con una
          herramienta de mercado, propongo esa alternativa.
        </p>
        <a
          class="text-link"
          href={identity.azhum}
          target="_blank"
          rel="noopener noreferrer"
        >
          Ver Azhum <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <CastilloOffice />

  <ContactCTA />
</Layout>
