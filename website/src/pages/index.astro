---
import Layout from "../layouts/Layout.astro";
import TransformationGraphic from "../components/TransformationGraphic.astro";
import AzhumLogo from "../components/AzhumLogo.astro";
import AzhumOffice from "../components/AzhumOffice.astro";
import ContactCTA from "../components/ContactCTA.astro";
import {
  capabilities,
  careerPath,
  cfoProblems,
  credentials,
  education,
  identity,
  steps,
  technologyOptions,
} from "../data/content";
---

<Layout
  title="Transformación financiera y sistemas · Castillo"
  description="Castillo conecta Finanzas y Tecnología: diagnóstico, procesos, arquitectura funcional, datos e implantación de soluciones lideradas por Gerson Castillo."
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="gold-dash"></span> CASTILLO · TRANSFORMACIÓN FINANCIERA
        </p>
        <h1>
          <span class="hero-line">Del problema</span>{" "}
          <span class="hero-line">financiero a la</span>{" "}
          <em>solución implantada.</em>
        </h1>
        <p class="hero-description">
          Diseño procesos, sistemas y soluciones tecnológicas para mejorar cómo
          Finanzas opera, controla y toma decisiones. Data & AI cuando aportan
          valor.
        </p>
        <div class="hero-actions">
          <a class="button" href="/contacto/#message-heading">
            Hablemos de tu proyecto <span aria-hidden="true">→</span>
          </a>
          <a class="text-link" href="#servicios">
            Explorar servicios <span aria-hidden="true">↓</span>
          </a>
        </div>
        <p class="hero-signature">
          Gerson Castillo <span>·</span> Finanzas, transformación y tecnología
        </p>
      </div>
      <TransformationGraphic />
    </div>
    <div class="wrap credentials-strip" aria-label="Credenciales profesionales">
      {credentials.map((credential) => (
        <span>{credential}</span>
      ))}
    </div>
  </section>

  <section class="section cfo-problems">
    <div class="wrap problems-grid">
      <div>
        <p class="eyebrow">CUÁNDO TIENE SENTIDO HABLAR</p>
        <h2>Cuando Finanzas sabe que algo tiene que cambiar.</h2>
        <p class="section-intro">
          El punto de partida no es una herramienta. Es una fricción concreta
          que afecta al control, la operación o la capacidad de decidir.
        </p>
      </div>
      <ol class="problem-list">
        {cfoProblems.map((problem, index) => (
          <li>
            <span>0{index + 1}</span>
            {problem}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bridge section">
    <div class="wrap split">
      <p class="eyebrow">EL PUNTO DE CONEXIÓN</p>
      <div>
        <h2>
          Finanzas conoce el problema.
          <br />
          Tecnología conoce los sistemas.
          <br />
          <em>La clave está en conectarlos.</em>
        </h2>
        <div class="two-copy">
          <p>
            La Dirección Financiera sabe qué necesita conseguir, pero no siempre
            puede convertirlo en arquitectura funcional, especificaciones,
            datos, integraciones y criterios de aceptación.
          </p>
          <p>
            IT conoce la tecnología, pero no necesariamente la lógica financiera
            y contable. Trabajo precisamente en esa frontera para convertir una
            necesidad del negocio en una solución que pueda construirse,
            validarse y operar.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="capabilities section" id="servicios">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">SERVICIOS</p>
          <h2>
            Del diagnóstico.
            <br />
            <em>A la solución implantada.</em>
          </h2>
        </div>
        <p>
          Cuatro líneas de trabajo conectadas por el mismo criterio financiero.
        </p>
      </div>
      <div class="capability-grid">
        {capabilities.map((service) => (
          <article class="capability" id={service.id}>
            <span class="number">{service.number}</span>
            <h3>{service.title}</h3>
            <p class="service-label">QUÉ PROBLEMA RESUELVE</p>
            <p>{service.problem}</p>
            <p class="service-label">QUÉ HACE CASTILLO</p>
            <p>{service.work}</p>
            <p class="tags">{service.tags}</p>
            <div class="service-deliverable">
              <span>QUÉ RECIBE EL CLIENTE</span>
              <strong>{service.deliverable}</strong>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section method" id="como-trabajo">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">CÓMO TRABAJO</p>
          <h2>
            El diseño es el inicio.
            <br />
            <em>La implantación, el compromiso.</em>
          </h2>
        </div>
        <p>Proyectos definidos por alcance, entregables y calendario.</p>
      </div>
      <ol class="steps">
        {steps.map(([title, description], index) => (
          <li>
            <span>0{index + 1}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </li>
        ))}
      </ol>
      <div class="method-note">
        <div>
          <span>INDEPENDENCIA TECNOLÓGICA</span>
          <h3>La tecnología es consecuencia del problema.</h3>
          <p>
            Castillo no parte de una herramienta predeterminada. La solución se
            decide después de entender el proceso, los datos, los controles y la
            arquitectura existente.
          </p>
        </div>
        <ul class="technology-options">
          {technologyOptions.map((option) => (
            <li>{option}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="ai-feature">
    <div class="wrap ai-grid">
      <div>
        <p class="eyebrow gold">
          DATA & AI / NUEVAS PALANCAS DE TRANSFORMACIÓN
        </p>
        <h2>
          Inteligencia artificial.
          <br />
          <em>Criterio financiero.</em>
          <br />
          Aplicación real.
        </h2>
        <p>
          Data & AI amplía las opciones de transformación. La pregunta sigue
          siendo qué problema merece resolverse, con qué datos y con qué
          controles.
        </p>
        <a class="button light" href="/ia-finanzas/">
          Explorar Data & AI para Finanzas <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="ai-opportunities">
        <p class="diagram-label">OPORTUNIDADES QUE PODEMOS EVALUAR</p>
        <a href="/ia-finanzas/#oportunidades">
          <span>01</span>
          <div>
            <h3>Operaciones con menos fricción</h3>
            <p>Automatización, agentes y procesamiento documental.</p>
          </div>
          <b aria-hidden="true">↗</b>
        </a>
        <a href="/ia-finanzas/#oportunidades">
          <span>02</span>
          <div>
            <h3>Información para anticiparse</h3>
            <p>Analítica avanzada, forecasting y señales de riesgo.</p>
          </div>
          <b aria-hidden="true">↗</b>
        </a>
        <a href="/ia-finanzas/#gobierno">
          <span>03</span>
          <div>
            <h3>IA con control y trazabilidad</h3>
            <p>Validación, supervisión humana y gobierno.</p>
          </div>
          <b aria-hidden="true">↗</b>
        </a>
        <p class="ai-note">
          Cada oportunidad parte de tus procesos, tus datos y tus criterios de
          riesgo.
        </p>
      </div>
    </div>
  </section>

  <section class="founder section" id="gerson">
    <div class="wrap founder-grid">
      <div class="founder-photo">
        <img
          src="/images/gerson.jpg"
          alt="Gerson Castillo"
          width="1280"
          height="1280"
          loading="lazy"
        />
        <span>GERSON CASTILLO / FUNDADOR</span>
      </div>
      <div class="founder-copy">
        <p class="eyebrow">GERSON CASTILLO</p>
        <h2>
          Finanzas, transformación
          <br />
          <em>y tecnología.</em>
        </h2>
        <p class="lead">
          Mi trayectoria profesional se ha desarrollado en la intersección entre
          la dirección financiera y los sistemas: desde la gestión de Finanzas
          en organizaciones complejas hasta el diseño e implantación de software
          y soluciones de datos.
        </p>
        <p>
          He trabajado desde tres lados de la misma mesa: como responsable
          financiero que compra y utiliza tecnología, como profesional que
          dirige implantaciones y como fundador que construye producto.
        </p>
        <div class="career-preview" aria-label="Trayectoria ejecutiva">
          {careerPath.slice(0, 4).map(([title]) => (
            <span>{title}</span>
          ))}
        </div>
        <p class="education-preview">
          <strong>Formación:</strong>{" "}
          {education.map(([degree]) => degree).join(" · ")}
        </p>
        <div class="inline-actions">
          <a class="button" href="/sobre-castillo/">
            Sobre Castillo y Gerson <span aria-hidden="true">→</span>
          </a>
          <a
            class="text-link"
            href={identity.linkedin}
            target="_blank"
            rel="noopener noreferrer"
          >
            Ver trayectoria completa en LinkedIn{" "}
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="azhum-section">
    <div class="wrap azhum-grid">
      <div>
        <p class="eyebrow">PRODUCTO PROPIO / INTELIGENCIA FINANCIERA</p>
        <h2 class="azhum-logo">
          <AzhumLogo />
        </h2>
      </div>
      <div>
        <h3>Capacidad tecnológica, construida.</h3>
        <p>
          Azhum es la plataforma de inteligencia financiera diseñada y
          construida por Gerson Castillo.
        </p>
        <p>
          Puede formar parte de una solución cuando encaja. Castillo mantiene
          independencia tecnológica para trabajar con la herramienta o
          arquitectura adecuada para cada proyecto.
        </p>
        <a
          class="text-link"
          href={identity.azhum}
          target="_blank"
          rel="noopener noreferrer"
        >
          Conocer Azhum <span aria-hidden="true">↗</span>
        </a>
        <AzhumOffice />
      </div>
    </div>
  </section>
  <ContactCTA />
</Layout>
