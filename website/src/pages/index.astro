---
import Layout from "../layouts/Layout.astro";
import TransformationGraphic from "../components/TransformationGraphic.astro";
import AzhumLogo from "../components/AzhumLogo.astro";
import CastilloOffice from "../components/CastilloOffice.astro";
import ContactCTA from "../components/ContactCTA.astro";
import {
  cfoProblems,
  practiceAreas,
  identity,
  services,
  steps,
} from "../data/content";
---

<Layout
  title="Modernización y automatización financiera · Castillo"
  description="Modernización de procesos y sistemas financieros: diagnóstico, reporting, integraciones y automatización hasta la puesta en marcha. Proyectos por fases. Madrid."
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="gold-dash"></span> DIRECCIÓN DE TRANSFORMACIÓN FINANCIERA
        </p>
        <h1>
          <span class="hero-line">Modernización y automatización</span>{" "}
          <em>de la función financiera.</em>
        </h1>
        <p class="hero-description">
          Proyectos para mejorar el cierre, el reporting y la conexión entre
          sistemas, desde el diagnóstico hasta la puesta en marcha.
        </p>
        <div class="hero-actions">
          <a class="button" href="/contacto/#message-heading">
            Hablemos de tu proyecto <span aria-hidden="true">→</span>
          </a>
          <a class="text-link" href="#como-trabajo">
            Metodología <span aria-hidden="true">↓</span>
          </a>
        </div>
        <div class="credentials-strip" aria-label="Ámbitos de trabajo">
          {practiceAreas.map((area) => (
            <span>{area}</span>
          ))}
        </div>
      </div>
      <TransformationGraphic />
    </div>
  </section>

  <section class="section cfo-problems">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">CUÁNDO TIENE SENTIDO HABLAR</p>
          <h2>Qué está frenando a tu equipo financiero.</h2>
        </div>
        <p>
          El primer paso es entender qué ocurre, cuánto pesa y por dónde
          conviene empezar.
        </p>
      </div>
      <ol class="problem-list">
        {cfoProblems.map(([title, description], index) => (
          <li>
            <span>0{index + 1}</span>
            <div>
              <h3>{title}</h3>
              <p>{description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bridge section">
    <div class="wrap split">
      <p class="eyebrow">EL PUNTO DE CONEXIÓN</p>
      <div>
        <h2>
          Finanzas conoce el problema.
          <br />
          Tecnología conoce los sistemas.
          <br />
          <em>La clave está en conectarlos.</em>
        </h2>
        <div class="two-copy">
          <p>
            La Dirección Financiera sabe qué necesita conseguir. Convertirlo en
            procesos, requisitos funcionales, datos, integraciones y criterios
            de aceptación requiere conocer la lógica financiera.
          </p>
          <p>
            Castillo conecta esas necesidades con el trabajo de IT: diseño
            funcional, datos, integraciones y pruebas. El proyecto abarca la
            definición de la solución y su puesta en marcha con el equipo.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="capabilities section" id="servicios">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">SERVICIOS</p>
          <h2>Diagnóstico y proyectos de transformación.</h2>
        </div>
        <p>
          Un diagnóstico para decidir por dónde empezar. Proyectos concretos
          para llevar las mejoras a operación.
        </p>
      </div>
      <div class="capability-grid">
        {services.map((service) => (
          <article class="capability" id={service.id}>
            <span class="number">{service.number}</span>
            <h3>{service.title}</h3>
            <p class="service-label">CUÁNDO TIENE SENTIDO</p>
            <p>{service.problem}</p>
            <p class="service-label">ALCANCE</p>
            <p>{service.work}</p>
            <ul class="service-examples">
              {service.examples.map((example) => (
                <li>{example}</li>
              ))}
            </ul>
            <div class="service-deliverable">
              <span>QUÉ RECIBE EL CLIENTE</span>
              <strong>{service.deliverable}</strong>
            </div>
          </article>
        ))}
      </div>
      <div class="continuity-note">
        <h3>Dirección de transformación a tiempo parcial.</h3>
        <p>
          Acompañamiento continuado para coordinar prioridades, equipos y
          siguientes fases. La dedicación y el alcance se acuerdan según las
          necesidades de la función financiera.
        </p>
      </div>
    </div>
  </section>

  <section class="section method" id="como-trabajo">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">METODOLOGÍA</p>
          <h2>
            Del problema financiero
            <br />
            <em>a la solución implantada.</em>
          </h2>
        </div>
        <p>
          Cada fase tiene alcance, entregables y criterios de aceptación. Los
          resultados se revisan antes de decidir el siguiente paso.
        </p>
      </div>
      <ol class="steps">
        {steps.map(([title, description], index) => (
          <li>
            <span>0{index + 1}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </li>
        ))}
      </ol>
      <div class="method-note">
        <div>
          <span>CRITERIO TECNOLÓGICO</span>
          <h3>La tecnología se elige después de entender el problema.</h3>
        </div>
        <p>
          Puede bastar con rediseñar un proceso o aprovechar mejor el ERP. En
          otros casos hacen falta integraciones, analítica, Power Platform,
          software específico o IA. La arquitectura y los equipos o proveedores
          se definen según las necesidades del proyecto.
        </p>
      </div>
    </div>
  </section>

  <section class="founder section" id="gerson">
    <div class="wrap founder-grid">
      <div class="founder-photo">
        <img
          src="/images/gerson.jpg"
          alt="Gerson Castillo"
          width="1280"
          height="1280"
          loading="lazy"
        />
        <span>GERSON CASTILLO</span>
      </div>
      <div class="founder-copy">
        <p class="eyebrow">DIRECCIÓN</p>
        <h2>Gerson Castillo</h2>
        <p class="lead">
          Llevo 17 años en Finanzas, en organizaciones multisociedad de
          Latinoamérica y Europa.
        </p>
        <p>
          He trabajado en dirección financiera y he dirigido implantaciones de
          software de consolidación en Iberia y Latinoamérica. Fui subdirector
          financiero en un grupo español de transporte y logística. Soy fundador
          y arquitecto de Azhum.
        </p>
        <div class="inline-actions">
          <a class="button" href="/sobre-castillo/">
            Sobre Castillo <span aria-hidden="true">→</span>
          </a>
          <a
            class="text-link"
            href={identity.linkedin}
            target="_blank"
            rel="noopener noreferrer"
          >
            Ver trayectoria completa en LinkedIn{" "}
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="ai-feature">
    <div class="wrap ai-grid">
      <div>
        <p class="eyebrow gold">ESPECIALIDAD / AUTOMATIZACIÓN E IA</p>
        <h2>
          Agentes de IA,
          <br />
          <em>con criterio financiero</em>
          <br />y control.
        </h2>
        <p>
          Diseño e implantación para tareas financieras concretas. El alcance
          delimita las acciones del agente, las aprobaciones necesarias y las
          pruebas que permiten verificar el resultado.
        </p>
        <a class="button light" href="/ia-finanzas/">
          Agentes en la función financiera <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="ai-opportunities">
        <p class="diagram-label">ANTES DE CONSTRUIR</p>
        <a href="/ia-finanzas/#oportunidades">
          <span>01</span>
          <div>
            <h3>Una tarea y un resultado concretos</h3>
            <p>
              Elegir entre reglas, automatización o un agente según el caso.
            </p>
          </div>
          <b aria-hidden="true">↗</b>
        </a>
        <a href="/ia-finanzas/#gobierno">
          <span>02</span>
          <div>
            <h3>Permisos y aprobación definidos</h3>
            <p>Qué puede ejecutar y qué debe revisar una persona.</p>
          </div>
          <b aria-hidden="true">↗</b>
        </a>
        <a href="/ia-finanzas/#gobierno">
          <span>03</span>
          <div>
            <h3>Evidencia y calidad verificables</h3>
            <p>Fuentes, acciones y excepciones registradas para su revisión.</p>
          </div>
          <b aria-hidden="true">↗</b>
        </a>
        <p class="ai-note">
          No toda tarea necesita IA. El problema define la solución.
        </p>
      </div>
    </div>
  </section>

  <section class="azhum-section">
    <div class="wrap azhum-grid">
      <div>
        <p class="eyebrow">PRODUCTO PROPIO / INTELIGENCIA FINANCIERA</p>
        <h2 class="azhum-logo">
          <AzhumLogo />
        </h2>
      </div>
      <div>
        <h3>Azhum, tecnología propia.</h3>
        <p>
          Azhum es la plataforma de inteligencia financiera diseñada y
          desarrollada por Gerson Castillo. Conecta contabilidad y datos
          operativos para analizar el resultado por cliente, línea o unidad, y
          seguir el origen de las cifras y sus reglas de atribución.
        </p>
        <p>
          Puede incorporarse cuando el proyecto necesita esa capacidad. La
          elección de herramientas responde al proceso, los datos y los sistemas
          existentes.
        </p>
        <div class="inline-actions">
          <a
            class="text-link"
            href={identity.azhum}
            target="_blank"
            rel="noopener noreferrer"
          >
            Conocer Azhum <span aria-hidden="true">↗</span>
          </a>
          <a
            class="text-link"
            href={identity.azhumDemo}
            target="_blank"
            rel="noopener noreferrer"
          >
            Ver el reporting en vivo <span aria-hidden="true">↗</span>
          </a>
        </div>
        <p class="demo-note">
          Reporting abierto, sin registro y con datos de demostración.
        </p>
      </div>
    </div>
  </section>
  <CastilloOffice />
  <ContactCTA />
</Layout>
