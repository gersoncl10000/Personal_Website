---
import Layout from "../layouts/Layout.astro";
import TransformationGraphic from "../components/TransformationGraphic.astro";
import AzhumLogo from "../components/AzhumLogo.astro";
import ContactCTA from "../components/ContactCTA.astro";
import { capabilities, steps, identity } from "../data/content";
---

<Layout>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="gold-dash"></span> CONSULTORÍA Y DESARROLLO PARA FINANZAS
        </p>
        <h1>
          <span class="hero-line">Del problema</span>{" "}
          <span class="hero-line">financiero a la</span>{" "}
          <em>solución implantada.</em>
        </h1>
        <p class="hero-description">
          Conecto finanzas, procesos, datos y tecnología para mejorar cómo tu
          organización opera, controla y toma decisiones.
        </p>
        <div class="hero-actions">
          <a class="button" href="/contacto/#message-heading">
            Formulario de contacto <span aria-hidden="true">→</span>
          </a>
          <a class="text-link" href="#capacidades">
            Explorar capacidades <span aria-hidden="true">↓</span>
          </a>
        </div>
        <p class="hero-signature">
          Gerson Castillo <span>·</span> Dirección financiera y construcción
          tecnológica
        </p>
      </div>
      <TransformationGraphic />
    </div>
    <div class="wrap hero-bottom">
      <span>TRANSFORMACIÓN FINANCIERA, DE PRINCIPIO A FIN</span>
      <span>
        Procesos <b>·</b> Sistemas <b>·</b> Data & AI <b>·</b> Implantación
      </span>
    </div>
  </section>
  <section class="bridge section">
    <div class="wrap split">
      <p class="eyebrow">EL PUNTO DE CONEXIÓN</p>
      <div>
        <h2>
          Finanzas conoce el problema.
          <br />
          Tecnología conoce los sistemas.
          <br />
          <em>La clave está en conectarlos.</em>
        </h2>
        <div class="two-copy">
          <p>
            Una transformación necesita algo más que una buena herramienta:
            necesita traducir el criterio financiero en procesos, requisitos y
            decisiones de diseño.
          </p>
          <p>
            Trabajo en esa intersección. Desde entender qué debe cambiar hasta
            construir la solución o dirigir su implantación con IT y los
            proveedores adecuados.
          </p>
        </div>
      </div>
    </div>
  </section>
  <section class="capabilities section" id="capacidades">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">CAPACIDADES</p>
          <h2>
            Cuatro perspectivas.
            <br />
            <em>Una transformación coherente.</em>
          </h2>
        </div>
        <p>
          Del proceso al sistema.
          <br />
          Del dato a la decisión.
          <br />
          Del diseño a la operación.
        </p>
      </div>
      <div class="capability-grid">
        {capabilities.map((c) => (
          <article class="capability" id={c.id}>
            <span class="number">{c.number}</span>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
            <p class="tags">{c.tags}</p>
            <details>
              <summary>
                Alcance y entregables <span aria-hidden="true">+</span>
              </summary>
              <div>
                <p>{c.detail}</p>
                <strong>{c.deliverable}</strong>
              </div>
            </details>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="ai-feature">
    <div class="wrap ai-grid">
      <div>
        <p class="eyebrow gold">FOCO / DATA & AI PARA FINANZAS</p>
        <h2>
          Inteligencia artificial.
          <br />
          <em>Criterio financiero.</em>
          <br />
          Aplicación real.
        </h2>
        <p>
          La pregunta no es dónde poner IA. Es qué problema merece resolverse
          con ella y qué hace falta para llevarla a la operación.
        </p>
        <a class="button light" href="/ia-finanzas/">
          Explorar IA para Finanzas <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="ai-opportunities">
        <p class="diagram-label">OPORTUNIDADES QUE PODEMOS EVALUAR</p>
        <a href="/ia-finanzas/#oportunidades">
          <span>01</span>
          <div>
            <h3>Operaciones con menos fricción</h3>
            <p>Agentes, automatización y procesamiento documental.</p>
          </div>
          <b aria-hidden="true">↗</b>
        </a>
        <a href="/ia-finanzas/#oportunidades">
          <span>02</span>
          <div>
            <h3>Información para anticiparse</h3>
            <p>Analítica avanzada, anomalías y modelos predictivos.</p>
          </div>
          <b aria-hidden="true">↗</b>
        </a>
        <a href="/ia-finanzas/#gobierno">
          <span>03</span>
          <div>
            <h3>IA con control y trazabilidad</h3>
            <p>Validación, supervisión humana y gobierno.</p>
          </div>
          <b aria-hidden="true">↗</b>
        </a>
        <p class="ai-note">
          Cada oportunidad parte de tus procesos, tus datos y tus criterios de
          riesgo.
        </p>
      </div>
    </div>
  </section>
  <section class="section method" id="enfoque">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">CÓMO TRABAJO</p>
          <h2>
            El diseño es el inicio.
            <br />
            <em>La implantación, el compromiso.</em>
          </h2>
        </div>
        <p>
          Proyectos definidos por alcance,
          <br />
          entregables y calendario.
        </p>
      </div>
      <ol class="steps">
        {steps.map(([title, description], i) => (
          <li>
            <span>0{i + 1}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </li>
        ))}
      </ol>
      <div class="method-note">
        <span>INDEPENDENCIA TECNOLÓGICA</span>
        <p>
          La solución puede apoyarse en tu ERP, IT interno, proveedores,
          plataformas low-code o desarrollo propio. La elección responde al
          problema.
        </p>
      </div>
    </div>
  </section>
  <section class="founder section" id="gerson">
    <div class="wrap founder-grid">
      <div class="founder-photo">
        <img
          src="/images/gerson.jpg"
          alt="Gerson Castillo"
          width="1280"
          height="1280"
          loading="lazy"
        />
        <span>GERSON CASTILLO / FUNDADOR</span>
      </div>
      <div>
        <p class="eyebrow">LA PERSONA DETRÁS DE CASTILLO</p>
        <h2>
          Entender Finanzas.
          <br />
          <em>Saber construir.</em>
        </h2>
        <p class="lead">
          Soy Gerson Castillo. Mi trayectoria conecta la dirección financiera
          con la implantación de sistemas y el desarrollo de software.
        </p>
        <p>
          Esa combinación me permite conversar con quienes operan el negocio y
          con quienes construyen la tecnología, y convertir sus necesidades en
          una solución compartida.
        </p>
        <p>
          Lidero personalmente los proyectos de Castillo, desde el diagnóstico
          hasta la implantación, colaborando con los equipos y especialistas que
          cada contexto requiere.
        </p>
        <a
          class="text-link"
          href={identity.linkedin}
          target="_blank"
          rel="noopener noreferrer"
        >
          Conocer mi trayectoria en LinkedIn <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
  <section class="azhum-section">
    <div class="wrap azhum-grid">
      <div>
        <p class="eyebrow">TECNOLOGÍA PROPIA / EMPRESA SEPARADA</p>
        <h2 class="azhum-logo">
          <AzhumLogo />
        </h2>
      </div>
      <div>
        <h3>Capacidad tecnológica, construida.</h3>
        <p>
          Azhum es la plataforma de inteligencia financiera que he diseñado y
          construido. Un producto propio que conecta software, datos e IA.
        </p>
        <p>
          Puede formar parte de un proyecto cuando encaja. La práctica de
          Castillo mantiene su independencia para elegir la tecnología adecuada.
        </p>
        <a
          class="text-link"
          href={identity.azhum}
          target="_blank"
          rel="noopener noreferrer"
        >
          Conocer Azhum <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
  <ContactCTA />
</Layout>
