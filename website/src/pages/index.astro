---
import Layout from "../layouts/Layout.astro";
import TransformationGraphic from "../components/TransformationGraphic.astro";
import AzhumLogo from "../components/AzhumLogo.astro";
import CastilloOffice from "../components/CastilloOffice.astro";
import ContactCTA from "../components/ContactCTA.astro";
import {
  careerPath,
  cfoProblems,
  credentials,
  education,
  identity,
  services,
  steps,
} from "../data/content";
---

<Layout
  title="Modernización y automatización financiera · Castillo"
  description="Gerson Castillo dirige y ejecuta transformación financiera: diagnóstico, procesos, sistemas y automatización por fases, hasta la puesta en marcha. Madrid."
>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">
          <span class="gold-dash"></span> DIRECCIÓN DE TRANSFORMACIÓN FINANCIERA
        </p>
        <h1>
          <span class="hero-line">Modernizo y automatizo</span>{" "}
          <em>tu función financiera.</em>
        </h1>
        <p class="hero-description">
          Diagnostico procesos y sistemas, priorizo las mejoras y construyo o
          dirijo cada solución hasta su puesta en marcha. Por fases acotadas,
          con entregables claros.
        </p>
        <div class="hero-actions">
          <a class="button" href="/contacto/#message-heading">
            Hablemos de tu proyecto <span aria-hidden="true">→</span>
          </a>
          <a class="text-link" href="#como-trabajo">
            Cómo trabajo <span aria-hidden="true">↓</span>
          </a>
        </div>
        <p class="hero-signature">
          Gerson Castillo <span>·</span> Finanzas, transformación y tecnología
        </p>
        <div class="credentials-strip" aria-label="Credenciales profesionales">
          {credentials.map((credential) => (
            <span>{credential}</span>
          ))}
        </div>
      </div>
      <TransformationGraphic />
    </div>
  </section>

  <section class="section cfo-problems">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">CUÁNDO TIENE SENTIDO HABLAR</p>
          <h2>Qué está frenando a tu equipo financiero.</h2>
        </div>
        <p>
          El primer paso es entender qué ocurre, cuánto pesa y por dónde
          conviene empezar.
        </p>
      </div>
      <ol class="problem-list">
        {cfoProblems.map(([title, description], index) => (
          <li>
            <span>0{index + 1}</span>
            <div>
              <h3>{title}</h3>
              <p>{description}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bridge section">
    <div class="wrap split">
      <p class="eyebrow">EL PUNTO DE CONEXIÓN</p>
      <div>
        <h2>
          Finanzas conoce el problema.
          <br />
          Tecnología conoce los sistemas.
          <br />
          <em>La clave está en conectarlos.</em>
        </h2>
        <div class="two-copy">
          <p>
            La Dirección Financiera sabe qué necesita conseguir. Convertirlo en
            procesos, requisitos funcionales, datos, integraciones y criterios
            de aceptación requiere conocer la lógica financiera.
          </p>
          <p>
            Trabajo en ese punto de conexión: entiendo el problema con Finanzas,
            especifico lo que IT necesita y construyo o dirijo la solución,
            comprobando con el equipo que funciona.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="capabilities section" id="servicios">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">QUÉ HAGO</p>
          <h2>
            Entender qué cambiar.
            <br />
            <em>Llevarlo a operación.</em>
          </h2>
        </div>
        <p>
          Un diagnóstico cuando hace falta. Después, proyectos acotados con
          resultados y criterios de aceptación acordados.
        </p>
      </div>
      <div class="capability-grid">
        {services.map((service) => (
          <article class="capability" id={service.id}>
            <span class="number">{service.number}</span>
            <h3>{service.title}</h3>
            <p class="service-label">CUÁNDO TIENE SENTIDO</p>
            <p>{service.problem}</p>
            <p class="service-label">QUÉ HAGO</p>
            <p>{service.work}</p>
            <ul class="service-examples">
              {service.examples.map((example) => (
                <li>{example}</li>
              ))}
            </ul>
            <div class="service-deliverable">
              <span>QUÉ RECIBE EL CLIENTE</span>
              <strong>{service.deliverable}</strong>
            </div>
          </article>
        ))}
      </div>
      <div class="continuity-note">
        <h3>Continuidad, cuando el proyecto la necesita.</h3>
        <p>
          Puedo acompañar la transformación a tiempo parcial, coordinando
          prioridades, equipos y siguientes fases. El alcance se acuerda según
          lo que necesita la función financiera.
        </p>
      </div>
    </div>
  </section>

  <section class="section method" id="como-trabajo">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow">CÓMO TRABAJO</p>
          <h2>
            Del problema financiero
            <br />
            <em>a la solución implantada.</em>
          </h2>
        </div>
        <p>
          Cada fase tiene alcance, entregables y criterios de aceptación.
          Revisamos lo conseguido antes de decidir el siguiente paso.
        </p>
      </div>
      <ol class="steps">
        {steps.map(([title, description], index) => (
          <li>
            <span>0{index + 1}</span>
            <h3>{title}</h3>
            <p>{description}</p>
          </li>
        ))}
      </ol>
      <div class="method-note">
        <div>
          <span>CRITERIO TECNOLÓGICO</span>
          <h3>La tecnología se elige después de entender el problema.</h3>
        </div>
        <p>
          Puede bastar con rediseñar un proceso o aprovechar mejor el ERP. En
          otros casos hacen falta integraciones, analítica, Power Platform,
          software específico o IA. Trabajo con la arquitectura adecuada y con
          los equipos o proveedores que el proyecto requiere.
        </p>
      </div>
    </div>
  </section>

  <section class="founder section" id="gerson">
    <div class="wrap founder-grid">
      <div class="founder-photo">
        <img
          src="/images/gerson.jpg"
          alt="Gerson Castillo"
          width="1280"
          height="1280"
          loading="lazy"
        />
        <span>GERSON CASTILLO / FUNDADOR</span>
      </div>
      <div class="founder-copy">
        <p class="eyebrow">QUIÉN ESTÁ DETRÁS</p>
        <h2>Gerson Castillo</h2>
        <p class="lead">
          Mi trayectoria combina dirección financiera, implantación de sistemas
          y construcción de software.
        </p>
        <p>
          He trabajado como responsable financiero, dirigiendo implantaciones y
          creando producto. Esa experiencia me permite conectar el problema del
          CFO con una solución que llega a operación.
        </p>
        <div class="career-preview" aria-label="Trayectoria ejecutiva">
          {careerPath.slice(0, 3).map(([title]) => (
            <span>{title}</span>
          ))}
          <span>Fundador y arquitecto de Azhum</span>
        </div>
        <p class="education-preview">
          <strong>Formación:</strong>{" "}
          {education.map(([degree]) => degree).join(" · ")}
        </p>
        <div class="inline-actions">
          <a class="button" href="/sobre-castillo/">
            Conocer el recorrido <span aria-hidden="true">→</span>
          </a>
          <a
            class="text-link"
            href={identity.linkedin}
            target="_blank"
            rel="noopener noreferrer"
          >
            Ver trayectoria completa en LinkedIn{" "}
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="ai-feature">
    <div class="wrap ai-grid">
      <div>
        <p class="eyebrow gold">ESPECIALIDAD / AUTOMATIZACIÓN E IA</p>
        <h2>
          Agentes de IA,
          <br />
          <em>con criterio financiero</em>
          <br />y control.
        </h2>
        <p>
          Identifico tareas donde un agente puede aportar valor, defino qué
          puede hacer y qué necesita aprobación, y construyo o dirijo la
          solución con pruebas y seguimiento.
        </p>
        <a class="button light" href="/ia-finanzas/">
          Cómo planteo los agentes <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="ai-opportunities">
        <p class="diagram-label">ANTES DE CONSTRUIR</p>
        <a href="/ia-finanzas/#oportunidades">
          <span>01</span>
          <div>
            <h3>Una tarea y un resultado concretos</h3>
            <p>
              Elegir entre reglas, automatización o un agente según el caso.
            </p>
          </div>
          <b aria-hidden="true">↗</b>
        </a>
        <a href="/ia-finanzas/#gobierno">
          <span>02</span>
          <div>
            <h3>Permisos y aprobación definidos</h3>
            <p>Qué puede ejecutar y qué debe revisar una persona.</p>
          </div>
          <b aria-hidden="true">↗</b>
        </a>
        <a href="/ia-finanzas/#gobierno">
          <span>03</span>
          <div>
            <h3>Evidencia y calidad verificables</h3>
            <p>Fuentes, acciones y excepciones registradas para su revisión.</p>
          </div>
          <b aria-hidden="true">↗</b>
        </a>
        <p class="ai-note">
          No toda tarea necesita IA. El problema define la solución.
        </p>
      </div>
    </div>
  </section>

  <section class="azhum-section">
    <div class="wrap azhum-grid">
      <div>
        <p class="eyebrow">PRODUCTO PROPIO / INTELIGENCIA FINANCIERA</p>
        <h2 class="azhum-logo">
          <AzhumLogo />
        </h2>
      </div>
      <div>
        <h3>Azhum, tecnología propia.</h3>
        <p>
          Azhum es la plataforma de inteligencia financiera que he diseñado y
          construido. Conecta contabilidad y datos operativos para analizar el
          resultado por cliente, línea o unidad, y seguir el origen de las
          cifras y sus reglas de atribución.
        </p>
        <p>
          La utilizo cuando encaja en el proyecto; cuando la solución adecuada
          es otra, propongo otra.
        </p>
        <div class="inline-actions">
          <a
            class="text-link"
            href={identity.azhum}
            target="_blank"
            rel="noopener noreferrer"
          >
            Conocer Azhum <span aria-hidden="true">↗</span>
          </a>
          <a
            class="text-link"
            href={identity.azhumDemo}
            target="_blank"
            rel="noopener noreferrer"
          >
            Ver el reporting en vivo <span aria-hidden="true">↗</span>
          </a>
        </div>
        <p class="demo-note">
          Reporting abierto, sin registro y con datos de demostración.
        </p>
      </div>
    </div>
  </section>
  <CastilloOffice />
  <ContactCTA />
</Layout>
